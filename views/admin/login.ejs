<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>strng &ndash; Admin Login</title>
  <style>
    body { font-family: sans-serif; max-width: 400px; margin: 60px auto; padding: 0 1rem; }
    h1 { margin-bottom: 0; }
    .subtitle { color: #555; margin-top: 0.25rem; margin-bottom: 2rem; }
    label { display: block; margin-bottom: 0.5rem; font-weight: bold; }
    input[type="password"] { width: 100%; padding: 0.5rem; box-sizing: border-box; }
    button { margin-top: 1rem; padding: 0.5rem 1.5rem; }
    .error { color: #c00; margin-bottom: 1rem; }
    .alt-link { margin-top: 1.5rem; font-size: 0.9rem; }
  </style>
</head>
<body>
  <h1>strng</h1>
  <p class="subtitle">Admin login</p>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="post" action="/admin/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="password">Admin password</label>
    <input type="password" id="password" name="password" required autofocus>
    <button type="submit">Log in</button>
  </form>

  <p class="alt-link"><a href="/login">&larr; User login</a></p>
</body>
</html>
